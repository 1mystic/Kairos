{
  "name": "kairos",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @kairos/app dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @kairos/core --filter @kairos/app test",
    "test:coverage": "pnpm --filter @kairos/core test:coverage",
    "test:rules": "firebase emulators:exec --only firestore --project demo-kairos \"pnpm --filter @kairos/firestore-tests test\"",
    "e2e": "pnpm --filter @kairos/app e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "build:prod": "VITE_USE_EMULATORS=false pnpm --filter @kairos/app exec vite build",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes --project kairos-76a0d --non-interactive",
    "deploy:preview": "pnpm build:prod && firebase hosting:channel:deploy preview --expires 7d --project kairos-76a0d --non-interactive",
    "deploy:hosting": "pnpm build:prod && firebase deploy --only hosting --project kairos-76a0d --non-interactive"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^16",
    "prettier": "^3",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
