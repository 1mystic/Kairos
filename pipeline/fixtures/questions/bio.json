    "key": "A",
    "text": "$3:1$"
   },
   {
    "key": "B",
    "text": "$1:2:1$"
   },
   {
    "key": "C",
    "text": "$9:3:3:1$"
   },
   {
    "key": "D",
    "text": "$1:1:1:1$"
   }
  ],
  "answer": {
