 {
  "id": "q_phy004",
  "type": "SCQ",
  "stem": "A planet has the same mass as Earth but $4$ times the radius of Earth. Its escape speed is what fraction of Earth's escape speed?",
  "images": [],
  "options": [
   {
    "key": "A",
    "text": "$\\tfrac14$"
   },
   {
    "key": "B",
    "text": "$\\tfrac12$"
   },
   {
    "key": "C",
    "text": "$2$"
   },
   {
    "key": "D",
    "text": "$4$"
   }
  ],
  "answer": {
   "keys": [
    "B"
   ]
  },
  "solution": "Escape speed $v_e=\\sqrt{2GM/R}$. With $M$ unchanged and $R\\to 4R$,\n\n$$\\frac{v_e'}{v_e}=\\sqrt{\\frac{1}{4}}=\\frac12.$$",
  "solution_source": "in_house",
  "tax": {
   "subject": "PHY",
   "chapter": "PHY.GRAV",
   "topics": [],
   "concepts": [
