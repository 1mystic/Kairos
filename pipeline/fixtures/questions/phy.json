 {
  "id": "q_phy006",
  "type": "SCQ",
  "stem": "The length of a simple pendulum is made four times. Its time period then becomes",
  "images": [],
  "options": [
   {
    "key": "A",
    "text": "$T/2$"
   },
   {
    "key": "B",
    "text": "$T$"
   },
   {
    "key": "C",
    "text": "$4T$"
   },
   {
    "key": "D",
    "text": "$2T$"
   }
  ],
  "answer": {
   "keys": [
    "D"
   ]
  },
  "solution": "$T=2\\pi\\sqrt{L/g}\\propto\\sqrt L$. For $L\\to4L$, $T\\to\\sqrt4\\,T=2T$.",
