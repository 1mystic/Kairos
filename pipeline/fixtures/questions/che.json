 {
  "id": "q_che006",
  "type": "SCQ",
  "stem": "For the equilibrium $\\ce{N2(g) + 3H2(g) <=> 2NH3(g)}$, the equilibrium constants are related by",
  "images": [],
  "options": [
   {
    "key": "A",
    "text": "$K_p=K_c(RT)^{2}$"
   },
   {
    "key": "B",
    "text": "$K_p=K_c(RT)^{-2}$"
   },
   {
    "key": "C",
    "text": "$K_p=K_c$"
   },
   {
    "key": "D",
    "text": "$K_p=K_c(RT)^{-4}$"
   }
  ],
  "answer": {
   "keys": [
    "B"
   ]
  },
  "solution": "$K_p=K_c(RT)^{\\Delta n_g}$ with $\\Delta n_g=2-(1+3)=-2$, so $K_p=K_c(RT)^{-2}$.",
  "solution_source": "in_house",
