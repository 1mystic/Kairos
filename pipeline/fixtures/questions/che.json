 {
  "id": "q_che003",
  "type": "SCQ",
  "stem": "The number of unpaired electrons in $\\mathrm{Fe^{3+}}$ ($Z=26$) in its ground state is",
  "images": [],
  "options": [
   {
    "key": "A",
    "text": "$3$"
   },
   {
    "key": "B",
    "text": "$4$"
   },
   {
    "key": "C",
    "text": "$6$"
   },
   {
    "key": "D",
    "text": "$5$"
   }
  ],
  "answer": {
   "keys": [
    "D"
   ]
  },
  "solution": "Fe: $[\\mathrm{Ar}]\\,3d^6 4s^2$. Removing three electrons (two $4s$, one $3d$) gives $3d^5$, with five unpaired electrons (Hund's rule).",
